# Copy to .env.local (ignored). Use local Supabase or an isolated staging backend.
# Never use the production backend for frontend development.
VITE_SUPABASE_URL=http://127.0.0.1:54321
# Public publishable key, or local legacy anon JWT; NEVER a secret/service-role key.
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_APP_ENV=development
VITE_APP_URL=http://localhost:5173
# VITE_SENTRY_DSN=
# Required when using hosted staging instead of local Docker. Build-only; not VITE_.
# ORCHESTR_STAGING_PROJECT_REF=
# Vercel Preview derives VITE_APP_URL from VERCEL_BRANCH_URL (fallback: VERCEL_URL). See ENVIRONMENTS.md.
