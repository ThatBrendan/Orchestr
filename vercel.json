{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/app/:path*",
      "destination": "/spa"
    },
    {
      "source": "/admin/:path*",
      "destination": "/spa"
    },
    {
      "source": "/auth/:path*",
      "destination": "/spa"
    },
    {
      "source": "/invite/:path*",
      "destination": "/spa"
    },
    {
      "source": "/access-denied",
      "destination": "/spa"
    },
    {
      "source": "/forgot-password",
      "destination": "/spa"
    },
    {
      "source": "/reset-password",
      "destination": "/spa"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "cleanUrls": true
}
